<?xml version="1.0" encoding="utf-8"?>
<!--
  ConfuserEx project for the PisoNetClient.

  PROFILE: STANDARD (renaming enabled)
  ────────────────────────────────────
  Goal: bump a "30-second dnSpy edit" attack into "weekend project for a
  competent reverser" without breaking runtime behavior.

  NOTE: the build scripts (build-obfuscated.bat and build/build-client.bat)
  generate their own .crproj on the fly with absolute paths. THIS file is a
  documentation/reference copy of the protection set — keep it in sync, but
  edits here do not affect the actual build.

  ENABLED protections:
    - ctrl flow      : turns each method body into a state machine.
                       Static call-graph analysis becomes useless.
    - constants      : encrypts string and numeric literals.  An attacker
                       grepping for "PISONEX_API" or "LicenseKey" in the
                       binary finds nothing.
    - anti debug     : refuses to run under a managed/unmanaged debugger.
                       Stops dnSpy attach + breakpoint workflow.
    - anti ildasm    : sets the SuppressIldasm attribute and adds a few
                       structural tweaks.  Minor — ILSpy ignores this — but
                       free.
    - rename (renPublic=true) : scrambles class/method/field names, INCLUDING
                       public members (this is an app, not a library, so no
                       external code consumes the public API). IsActive,
                       LicenseService, GetDeviceId etc. become single-letter
                       names. The 4 JSON DTO classes are excluded at the
                       source via <Obfuscation(Exclude:=True,
                       ApplyToMembers:=True)> attributes (HeartbeatResponse,
                       MemberRegisterResponse, MemberLoginResponse,
                       MemberLogoutResponse) so System.Text.Json
                       deserialisation keeps working.

  DISABLED (intentionally):
    - anti tamper    : refuses to run if the assembly hash doesn't match
                       what ConfuserEx baked in.  Sounds good, but breaks
                       Authenticode signing (signing modifies the file
                       after obfuscation -> tamper check fails at startup).
                       Either sign-then-tamper (impossible — tamper has to
                       know the final bytes) or use anti-tamper instead of
                       Authenticode.  For now, prefer Authenticode.
    - resources      : compresses embedded resources.  Already small, not
                       worth the runtime cost.
    - ref proxy      : adds proxy methods for external API calls.  Useful
                       but slows startup noticeably; revisit later.

  HOW TO USE:
    Run pisonex/client/build-obfuscated.bat from a Developer Command Prompt.
    See pisonex/client/obfuscation/README.md for the full workflow.
-->
<project outputDir="..\..\..\build\client-obfuscated"
         baseDir="..\..\..\build\client-publish"
         xmlns="http://confuser.codeplex.com">

  <!-- Global rule: apply to every type in PisoNetClient.dll -->
  <rule pattern="true" preset="none" inherit="false">
    <protection id="anti debug"  />
    <protection id="anti ildasm" />
    <protection id="constants"   />
    <protection id="ctrl flow"   />
    <protection id="rename">
      <!-- renPublic=true is required for an application: nothing external
           references our public API, so public members are safe to rename.
           Without this, ConfuserEx skips all Public classes/members. -->
      <argument name="renPublic" value="true" />
    </protection>
  </rule>

  <!-- Module under protection.  Path is relative to baseDir above. -->
  <module path="PisoNetClient.dll">
    <!--
      EXCLUSIONS — methods/types that must NOT be obfuscated.
      Even with renaming disabled, control-flow + constants protection
      can still break code that relies on reflection.  Add patterns
      here if a feature breaks after obfuscation.

      Example: if the licence-verifier ever uses reflection to read
      claims, exclude it like this:
        <rule pattern="name() = 'TokenClaims'" preset="none" inherit="false" />
    -->
  </module>

</project>
