[Unit]
Description=Pisonex Server
Documentation=https://github.com/yourrepo/pisonet
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/pisonet/server-orangepi
Environment="PATH=/home/pi/pisonet/server-orangepi/venv/bin"
ExecStart=/home/pi/pisonet/server-orangepi/venv/bin/uvicorn main:app \
    --host 0.0.0.0 \
    --port 80 \
    --workers 1 \
    --log-level info

# Allow binding to port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Always restart on crash (3 second cooldown)
Restart=always
RestartSec=3

# Kill cleanly
KillMode=mixed
TimeoutStopSec=10

# Log to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pisonet

[Install]
WantedBy=multi-user.target
