# Pisonex Server Configuration
# Copy this to .env and customize values

# Server settings
DATABASE_URL=sqlite:///./pisonet.db
SECRET_KEY=change-this-to-a-random-256-bit-secret-key
TOKEN_EXPIRE_HOURS=8
SERVER_HOST=0.0.0.0
SERVER_PORT=80

# Coin rates (in seconds)
DEFAULT_RATE_PESOS=5
DEFAULT_RATE_SECONDS=1800

# PC monitoring
PC_HEARTBEAT_TIMEOUT=30

# Admin credentials (used on first run only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Branch name for this installation (shown in pisonex.com customer portal)
# Set this so the portal groups your PCs by branch, e.g. "Tomas Morato Branch"
# Leave empty to appear under "Unassigned" in the portal.
BRANCH_NAME=

# PC client API key (leave empty to disable)
CLIENT_API_KEY=

# HMAC secret for license API payloads (auto-generated on first run if default)
LICENSE_HMAC_SECRET=PISONEX-INTERNAL-2026-CHANGE-BEFORE-RELEASE

# Membership settings
MEMBERSHIP_ENABLED=false
ABSORPTION_ENABLED=false
LOGOUT_DEDUCTION_MINUTES=5
MINIMUM_LOGOUT_MINUTES=10
ZERO_TIME_AUTO_LOGOUT_SECONDS=30
IDLE_AUTO_SHUTDOWN_MINUTES=5
MEMBER_HEARTBEAT_TIMEOUT_MINUTES=60

# GPIO pins — Orange Pi SoC numbering (OPi.GPIO BCM mode)
# Allwinner ports: PA0=0, PA1=1, PB0=32, PC0=64, PC1=65, etc.
# Run 'gpio readall' on the board and set values matching your wiring.
# COIN_PIN / RELAY_PIN / COIN_EDGE / COIN_DEBOUNCE_MS / COIN_PULSE_TIMEOUT can
# also be changed from the dashboard at Settings → Coin Slot Hardware (applied
# immediately, no restart). The DB value takes precedence over these defaults.
COIN_PIN=4
RELAY_PIN=6
# Keypad/LCD are no longer used (coin-slot-only build) — these are kept only so
# the kept-but-unused keypad.py / lcd.py drivers still import cleanly.
KEYPAD_ROWS=[17,27,22,5]
KEYPAD_COLS=[9,11,10]
LCD_I2C_ADDRESS=0x27
LCD_I2C_PORT=1

# Coin signal edge polarity
COIN_EDGE=FALLING

# Timing
COIN_DEBOUNCE_MS=30
COIN_PULSE_TIMEOUT=3.0
KEYPAD_SCAN_INTERVAL=0.05
PC_IDLE_TIMEOUT=30
DISPLAY_CONFIRM_DELAY=3
