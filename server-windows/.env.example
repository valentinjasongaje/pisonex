# Pisonex Server Configuration
# Copy this to .env and customize values

# Server settings
DATABASE_URL=sqlite:///./pisonet.db
SECRET_KEY=change-this-to-a-random-256-bit-secret-key
TOKEN_EXPIRE_HOURS=8
SERVER_HOST=0.0.0.0
SERVER_PORT=80

# Coin rates (in seconds)
DEFAULT_RATE_PESOS=5
DEFAULT_RATE_SECONDS=1800

# PC monitoring
PC_HEARTBEAT_TIMEOUT=30

# Admin credentials (used on first run only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Branch name for this installation (shown in pisonex.com customer portal)
# Set this so the portal groups your PCs by branch, e.g. "Tomas Morato Branch"
BRANCH_NAME=My Internet Cafe

# PC client API key (leave empty to disable)
CLIENT_API_KEY=

# HMAC secret for license API payloads.
# When the official installer (install_windows.bat / windows_service.py)
# generates a fresh .env, this is populated with a 256-bit random value
# automatically.  If the literal default below is ever loaded at startup,
# main.py replaces it with a random value and writes it back to .env.
LICENSE_HMAC_SECRET=PISONEX-INTERNAL-2026-CHANGE-BEFORE-RELEASE

# Membership settings
MEMBERSHIP_ENABLED=false
ABSORPTION_ENABLED=false
LOGOUT_DEDUCTION_MINUTES=5
MINIMUM_LOGOUT_MINUTES=10
ZERO_TIME_AUTO_LOGOUT_SECONDS=30
IDLE_AUTO_SHUTDOWN_MINUTES=5
MEMBER_HEARTBEAT_TIMEOUT_MINUTES=60
